# Google AI Studio — https://aistudio.google.com/apikey
# Primary provider for JD extraction, bullet rewrite, cover letter, and humanize.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional — defaults to gemini-2.5-flash-lite (best free-tier limits)
# GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash-lite

# Groq — https://console.groq.com/keys
# Optional fallback when Gemini quota is hit (or sole provider if Gemini key is unset)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Vercel: add GOOGLE_GENERATIVE_AI_API_KEY in Project → Settings → Environment Variables
# for Production, Preview, and Development. Match checks run client-side without this key.

# Supabase — https://supabase.com/dashboard (Project Settings → API)
# Required. Sign-in is gated behind these; the app will not build/run auth routes without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# After creating the project, run supabase/schema.sql in the Supabase SQL editor
# to create the user_data table + row-level security policies.
